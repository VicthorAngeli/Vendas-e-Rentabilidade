	partition meta_mensal = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(PastaDados & "\meta_mensal.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"id_meta", Int64.Type}, {"id_vendedor", Int64.Type}, {"data_mes", type date}, {"ano_mes_num", Int64.Type}, {"valor_meta", type number}}, "en-US")
				in
				    ChangedTypes

